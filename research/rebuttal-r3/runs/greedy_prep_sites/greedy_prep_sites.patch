+    def _prep_sites(self, trace: tuple, ctx: "_Ctx", v2p_initial: list[int]) -> list[int]:
+        """Site of each virtual rail when its pair's preparation herald fires in ``trace``; entry site otherwise.
+
+        Greedy otherwise commits from the entry layout (``_route`` ->
+        ``_greedy_commit_ctx``), in which the last backward pass can leave a
+        pair separated until the final route joins it before its preparation
+        (``LowerExpansion`` emits preparations first, expansion.py:68-86). The
+        Rust router returns only an event stream ``(kind, a, b)``
+        (crates/src/prism_routing/routing.rs:71-78), with no per-operation
+        layout, so the sites are read by replaying it as
+        ``_emit_circuit_from_trace`` does.
+        """
+        events, _, _ = trace
+        v2p = list(v2p_initial)
+        p2v = self._invert(v2p, ctx.n_phys)
+        sites = list(v2p_initial)
+        for kind, a, b in events:
+            if kind == self._EVENT_SWAP:
+                v_a, v_b = p2v[a], p2v[b]
+                v2p[v_a], v2p[v_b] = v2p[v_b], v2p[v_a]
+                p2v[a], p2v[b] = p2v[b], p2v[a]
+            elif ctx.op_nodes[a].op.name in ("joint_herald", "reset"):
+                for q in ctx.op_nodes[a].qargs:
+                    v = ctx.q_to_virt[q]
+                    sites[v] = v2p[v]
+        return sites
+
     @staticmethod
