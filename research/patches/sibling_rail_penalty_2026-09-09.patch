+) -> Option<usize> {
+    let mut best: Option<(usize, (f64, f64))> = None;
+    for (r_idx, real) in realizations.iter().enumerate() {
+        if !real.iter().all(|p| dist[[p[0].index(), p[1].index()]] == 1.0) {
+            continue;
+        }
+        let load: f64 = real.iter().flat_map(|p| [p[0].index(), p[1].index()]).map(|i| phys_load[i]).sum();
+        let key = (pen[r_idx], load);
+        let take = match best {
+            None => true,
+            Some((_, b)) => key < b || (key == b && r_idx == default_idx),
+        };
+        if take {
+            best = Some((r_idx, key));
+        }
+    }
+    best.map(|(idx, _)| idx)
+}
