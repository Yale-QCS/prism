+/// `min_r (sum_p dist[p] + pen[r])`, optionally under a virtual `swap`.
+pub fn op_cost_min_pen(
+    realizations: &[Box<[[PhysicalQubit; 2]]>],
+    swap: Option<[PhysicalQubit; 2]>,
+    dist: &ArrayView2<f64>,
+    pen: &[f64],
+) -> f64 {
+    let permute = |p: PhysicalQubit| match swap {
+        Some([a, b]) if p == a => b,
+        Some([a, b]) if p == b => a,
+        _ => p,
+    };
+    realizations
+        .iter()
+        .zip(pen)
+        .map(|(real, pen)| {
+            real.iter()
+                .map(|p| dist[[permute(p[0]).index(), permute(p[1]).index()]])
+                .sum::<f64>()
+                + pen
+        })
+        .fold(f64::INFINITY, f64::min)
+}
+
+/// `(logical qubit, rail)` of every virtual wire a realization touches.
+pub fn rails_of(real: &[[VirtualQubit; 2]], wpl: u32) -> Box<[(u32, u8)]> {
+    let mut out: Vec<(u32, u8)> = Vec::with_capacity(2 * real.len());
+    for pair in real {
+        for v in pair {
+            let v = v.index() as u32;
+            let entry = (v / wpl, (v % wpl) as u8);
+            if !out.contains(&entry) {
+                out.push(entry);
+            }
+        }
+    }
+    out.into_boxed_slice()
+}
