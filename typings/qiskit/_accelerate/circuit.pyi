# Nominal stub for the Rust-defined Qiskit circuit types. It gives each class a
# real identity so annotations such as GenericPass[DAGCircuit, MultiRealization]
# mean something to a checker; members stay Any. Other names in the module are Any.
from collections.abc import Iterator
from typing import Any

class _Opaque:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...

class DAGCircuit(_Opaque): ...
class DAGNode(_Opaque): ...
class DAGOpNode(DAGNode): ...
class DAGInNode(DAGNode): ...
class DAGOutNode(DAGNode): ...
class Bit(_Opaque): ...
class Qubit(Bit): ...
class Clbit(Bit): ...
class AncillaQubit(Qubit): ...

class Register(_Opaque):
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __getitem__(self, key: Any) -> Any: ...

class QuantumRegister(Register): ...
class ClassicalRegister(Register): ...
class AncillaRegister(QuantumRegister): ...

def __getattr__(name: str) -> Any: ...
